# Uygulama
APP_ENV=development
LOG_LEVEL=INFO
# Frontend Vite kullaniyorsa 5173, CRA kullaniyorsa 3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Veritabani ---------------------------------------------------------
# BOS birakilirsa repository katmani bellek ici veriyi kullanir (test/demo).
# Doluysa db/v5_schema_and_data.sql semasi beklenir.
#
# BU DOSYA SABLONDUR VE GIT'E GIRER - buraya GERCEK sifre YAZMAYIN.
# Gercek deger `backend/.env` icine yazilir (.gitignore'da, git'e girmez).
# Surucu eki `+psycopg` ile yazilir; backend/README.md ve testler bu bicimi
# kullanir (db/session.py ikisini de kabul eder).
# DATABASE_URL=postgresql+psycopg://KULLANICI:SIFRE@HOST:5432/VERITABANI
DB_ECHO=false

# --- Kimlik dogrulama ---------------------------------------------------
# Uretimde MUTLAKA degistirin.
JWT_SECRET=gelistirme-icin-gecici-anahtar-en-az-32-bayt
JWT_EXPIRE_MINUTES=720
# Token imza algoritmasi. Degistirmek icin bir sebep yoksa dokunmayin -
# mevcut oturumlar gecersiz olur.
# JWT_ALGORITHM=HS256

# --- RAG / Vector DB ----------------------------------------------------
# Model secildi: Cohere embed-v4 (output_dimension=1024, native destek -
# vector(1024) semasinda degisiklik gerekmez). EMBEDDING_API_KEY bos oldugu
# surece rag_search yalnizca BM25 ayagiyla calismaya devam eder.
EMBEDDING_MODEL=embed-v4.0
EMBEDDING_DIM=1024
EMBEDDING_API_KEY=

# Sorgu anindaki embedding cagrisinin ust siniri (saniye). Ingestion'daki
# toplu embedding'den ayri ve KISA tutulur: kullanici akan bir sohbette
# bekliyor. Asilirsa hibrit arama sessizce BM25'e duser, istek cokmez.
# RAG_QUERY_EMBEDDING_TIMEOUT_SECONDS=3.0

# --- LLM ----------------------------------------------------------------
# SAGLAYICI MODEL ADINDAN OTOMATIK ANLASILIR (bkz. app/core/llm.py):
#
#   gemini-3.5-flash-lite               -> Google AI Studio
#   nvidia/nemotron-3-super-120b-a12b   -> NVIDIA NIM
#   meta/llama-3.3-70b-instruct         -> NVIDIA NIM
#
# Kural: NIM kimlikleri `yayinci/model` bicimindedir ve `/` icerir, Gemini
# kimlikleri icermez. Ayri bir "saglayici" ayari YOK; gerekirse LLM_PROVIDER
# ile elle zorlanabilir (normalde bos birakin).
#
# ANAHTARLAR: hangi saglayiciyi kullaniyorsaniz onunkini doldurun. Ikisini
# birden doldurup ajan bazinda karistirabilirsiniz (orn. sentez NIM'de,
# guvenlik Gemini'de).
GEMINI_API_KEY=
NVIDIA_API_KEY=

# Geriye donuk: eski .env dosyalari Gemini anahtarini burada tutuyordu.
# GEMINI_API_KEY bos ise bu kullanilir.
LLM_API_KEY=

# Saglayici tespitini elle ezmek icin: gemini | nvidia. Normalde BOS.
LLM_PROVIDER=

# NIM ucu. Normalde degistirmeyin - kod bu degeri varsayilan olarak zaten
# kullaniyor. Kendi NIM konteynerinizi calistiriyorsaniz buraya onun adresini
# yazin (sonunda `/v1` OLMALI; yoksa istekler `/chat/completions` yoluna
# gidip 404 alir).
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Model secimi -------------------------------------------------------
# Olculmus durum (polifin-model-secimi/ testleri, Agustos 2026):
#
#   GUVENLIK  gemini-3.5-flash-lite  KARAR VERILDI
#             F1 0.970, duyarlilik %100, ayristirilamayan %0, p50 0.66 sn.
#             Sadece-regex taban cizgisi F1 0.500 idi.
#             BURADA KALIYOR: guvenlik ajani yanittan ILK SAYIYI okuyor, bu is
#             kucuk ve hizli bir modelle daha guvenli. Ayrica yalnizca regex
#             tetiklendiginde calisiyor - Gemini kotasini zorlamaz.
#
#   AJANLAR   nvidia/nemotron-3-super-120b-a12b
#   SENTEZ    nvidia/nemotron-3-super-120b-a12b
#
#             `nim-tani.py --tara` ile 12 aday ayni Turkce prompt'la sinandi
#             (25 Agustos 2026). Sonuc:
#
#               kimi-k3        2.6 sn  Turkcesi acik ara en iyi. SENTEZE
#                                      KONDU, SONRA GERI ALINDI - asagiya bakin.
#               super-120b     2.0 sn  Dogru ve hizli, uslubu biraz hantal.
#                                      SENTEZ DE BU MODELDE - sebep asagida.
#
#             ⚠️ TEK SEFERLIK OLCUM SENTEZ ICIN YETMIYOR (26 Agustos 2026).
#             Yukaridaki sureler `chat.completions.create` ile, 120 token'lik
#             kucuk bir istekle olculdu. Sentez ise AKIS yolunu kullaniyor
#             (`ChatOpenAI.astream`) ve orada tablo tamamen degisti.
#             `nim-tani.py --akis` ile ayni prompt, ayni anahtar:
#
#               model            ilk icerik   toplam        hiz   durum
#               super-120b           1.3 sn     1.9 sn  314 krkt/sn  tamam
#               minimax-m3           6.7 sn    25.3 sn   22 krkt/sn  tamam
#               kimi-k3                   -     0.6 sn            -  HATA
#               deepseek-v4-flash         -     0.5 sn            -  HATA
#
#             Kimi K3 once yavasladi (356 karakterlik yaniti 75.5 saniyede
#             yazdi = 4.7 krkt/sn), sonra tamamen hata vermeye basladi.
#             Canlida "synthesizer ajani gecici olarak tamamlanamadi
#             (timeout)" bundandi - kod dogruydu, uc tikanmisti.
#
#             DERS: sentez modelini SECMEDEN ONCE `--akis` ile olcun. Tek
#             seferlik hiz akis hizini TAHMIN ETTIRMIYOR - Kimi ikisinde 30
#             kat farkli davrandi.
#
#             Bunun bedeli: ajanlar ve sentez artik AYNI modelde, yani ayni
#             uc coktugunde yanitin tamami etkilenir. Onceki secim bilerek
#             farkli yayincilardandi. Akista ayakta duran baska aday cikinca
#             sentez tekrar ayrilmali.
#               minimax-m3     1.1 sn  En hizlisi, Turkcesi iyi. Yedek aday.
#               lightning-30b  1.7 sn  ⚠️ Turkcesi BOZUK ("THYAO'nun
#                                      yatirimcilarina ... dusmesi sonucu").
#                                      Hizli ama kullanilamaz.
#               ultra-550b     1.6 sn  ⚠️ UYDURUYOR. "Sadece %12 dustu"
#                                      denen prompt'a jet yakiti maliyeti,
#                                      dolar kuru, kuresel yavaslama gibi
#                                      girdide OLMAYAN sebepler uretti.
#                                      Iki ayri kosumda da ayni. Sentez
#                                      prompt'u "veri uydurma" diyor -
#                                      bu model onu ihlal ediyor. KULLANMAYIN.
#
#             Ikisi FARKLI yayincida olmasi bilincli: biri asiri yuklenirse
#             yanitin tamami degil bir parcasi bozulur.
#
# ⚠️ KATALOGDA OLMAK = CALISIYOR DEMEK DEGIL. 12 adaydan yalnizca 5'i yanit
#    verdi: 4'u 404 (listede var, servis edilmiyor), 2'si 25 sn'de timeout
#    (google/gemma-4-31b-it ve openai/gpt-oss-120b - ikisi de iki kez
#    denendi). Model degistirmeden once `nim-tani.py --tara` calistirin.
#
# ⚠️ MODEL ADINI TAM YAZIN. NVIDIA ayni model icin IKI ad kullaniyor ve
#    ikisi ayni yerde gecerli DEGIL:
#
#      nvidia/nemotron-3-ultra              NIM konteyner dokumaninda gecer,
#                                           hosted ucta "404 page not found"
#      nvidia/nemotron-3-ultra-550b-a55b    integrate.api.nvidia.com'da
#                                           CALISAN kimlik  <-- bunu kullanin
#
#    Bu canlida olculdu: kisa adla her LLM cagrisi 404 aliyordu.
#
# ⚠️ SLASH SART. Saglayici model adindan anlasiliyor
#    (app/core/llm.py::saglayici_belirle): "/" varsa NIM, yoksa Gemini.
#    Slash'siz yazarsaniz sistem modeli GEMINI sanar.
#
# Emin degilseniz backend/nim-tani.py calistirin: sunucudaki gercek model
# kimliklerini listeler ve ornek bir istek atip hatayi oldugu gibi basar.
DEFAULT_MODEL=nvidia/nemotron-3-super-120b-a12b
SECURITY_MODEL=gemini-3.5-flash-lite

# Ajan bazli override (bos birakilirsa DEFAULT_MODEL kullanilir).
#
# SYNTHESIZER_MODEL ozel: sentez adimi token token akitabilmek icin LangChain
# `ChatOpenAI` ile kuruluyor (app/core/llm.py::get_streaming_llm) ve bu YALNIZCA
# NIM modelleri icin calisiyor. Buraya bir Gemini modeli yazarsaniz sentez yine
# LLM ile yapilir ama akis olmaz - yanit tek parca gelir.
PORTFOLIO_MODEL=
MARKET_MODEL=
RISK_MODEL=
SYNTHESIZER_MODEL=nvidia/nemotron-3-super-120b-a12b

# Ornekleme sicakligi. DUSUK TUTUN: ajan promptlari "YENI SAYI URETME" ve
# "kaynakta olmayan bilgi uydurma" diyor. (Nemotron karti 1.0 oneriyor -
# o degere gecerseniz uydurma-sayi denetleyicisiyle olcup karar verin.)
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# NIM istekleri akil yurutmeyi kapatan ek alanlar tasir (`enable_thinking` hem
# top-level hem `chat_template_kwargs` icinde). Model bunlari tanimayip 400
# donerse 1 yapin - o zaman model dusunerek yanit verir ve sentez uzar.
LLM_NVIDIA_EXTRA_BODY_OFF=0

# --- Piyasa verisi katmani ----------------------------------------------
# api (varsayilan) : Yahoo Finance'ten GERCEK fiyat (app/market/yahoo.py)
# simulated        : rastgele yuruyus - yalnizca agsiz gelistirme/test icin
#
# "api" seciliyken Yahoo'ya ulasilamazsa veya gunluk kota dolarsa yeni fiyat
# yazilmaz; son dogrulanmis fiyat korunur.
#
# ⚠️ SIMULE FIYAT VERITABANINA HIC YAZILMAZ - "simulated" bilerek secilse
# bile scheduler o tick'i atlar. Ortak veritabanini kirletmenin son yolu da
# boylece kapali (20 Agustos 2026'da price_history'ye tek gunde 3.616 sahte
# satir bu yoldan girmisti).
#
# PAYLASILAN VERITABANI UYARISI: DATABASE_URL ortak bir veritabanini (orn.
# ekibin Supabase'i) gosteriyorsa backend'i lokalde acan HER gelistirici o
# veritabanina fiyat yazar ve ayni Yahoo kotasini harcar. Yalnizca arayuzle
# ugrasiyorsaniz PRICE_TICK_SECONDS=0 ile fiyat gorevini tamamen kapatin.
MARKET_DATA_PROVIDER=api

# Fiyat gorevinin calisma araligi (saniye). 900 = 15 dakika -> gunde 96 tick.
# 0 = fiyat gorevi hic baslamaz.
#
# ⚠️ BU DEGERI KUCULTMEYIN. Bir tick TEK istek DEGILDIR: yfinance her ticker
# icin ayri HTTP istegi atar. 900'de gunde ~1.536 istek; 60'ta SAATTE 960
# istek eder ve 2.500'luk gunluk kota ~2,6 saatte biter. Kota bitince yeni
# fiyat hic yazilmaz, fiyatlar gunun geri kalaninda donar.
#
# 300 saniyenin altinda backend acilista uyari basar.
PRICE_TICK_SECONDS=900

# Her N tick'te bir live_prices'a satir yazilir. 1 = her tick.
# price_history'ye gun ici YAZILMAZ; oraya yalnizca gun bitiminde gunun
# kapanis fiyati tasinir (bkz. MARKET_DAY_TIMEZONE).
# Degisken adi eski .env dosyalari bozulmasin diye ayni birakildi.
PRICE_HISTORY_EVERY_N_TICKS=1

# Gun sinirinin belirlendigi saat dilimi. Bu saat diliminde gun degisince
# live_prices bosaltilir ve gunun son fiyati price_history'ye kapanis olarak
# yazilir. Sunucu UTC calissa bile gun Turkiye saatine gore biter.
MARKET_DAY_TIMEZONE=Europe/Istanbul

# Portfoy performans grafiginin guvenilir veri baslangici (ISO 8601).
# Bu tarihten onceki gelistirme/simulasyon kayitlari grafige alinmaz.
PORTFOLIO_PERFORMANCE_VALID_FROM=2026-08-21T10:41:00+03:00

# Gunluk dis API ISTEK tavani (market_api_usage tablosuyla takip edilir).
# Sayac ticker bazlidir: beklenen gunluk hacim ~1.536, tavan pay birakir.
MARKET_API_DAILY_QUOTA=2500

MARKET_SIM_SEED=20260813

# --- Orkestrasyon timeout ayarlari (bir ajan asilirsa istek dusmesin) ----
#
# IKI KADEMELI. Tek sinir YETMIYORDU: dis timeout `_execute`'un TAMAMINI
# sardigi icin LLM adimi butceyi asinca `return` satirina hic ulasilmiyor,
# ilk adimda HESAPLANMIS RAKAMLAR da cope gidiyordu. Ardindan risk ajani
# portfoy verisi bulamayip `tool_error` veriyor, sentezleyici "veriye
# ulasilamadi" diyordu. Tek yavas LLM cagrisi, elde hazir duran veriyi
# goturuyordu.
#
#   dis sinir (bu deger)  -> tum `_execute`'u sarar, EMNIYET SUBABI
#   ic sinir (asagidaki)  -> yalnizca LLM cagrisini sarar; asilirsa ajan
#                            kendi icinde yakalar, deterministik ozete duser
#                            ve HESAPLANMIS VERIYI DONDURUR
#
# 20 DEGIL: canlida olculdu, 550B'lik bir modelle yorum yazan portfoy
# ajanina yetmiyor. Kod varsayilani da 45.
AGENT_TIMEOUT_SECONDS=45

# Ajan ICINDEKI LLM cagrisinin ust siniri.
# 0 = OTOMATIK: dis sinirin %60'i (45 -> 27 sn LLM, 18 sn tool + ozet payi).
# Elle deger verirseniz dis sinirdan KUCUK olmali; aksi halde dis iptal once
# devreye girer ve iki kademeli yapinin anlami kalmaz. Kod ayrica
# `agent_timeout_seconds - 5` tavaniyla kirpar.
AGENT_LLM_TIMEOUT_SECONDS=0

# `asyncio.wait_for` TUM sentezi sarar - ilk token'a varis degil TAMAMLANMA
# suresidir.
#
# 90 DEGIL: 90, artik kullanilmayan Nemotron 3 Ultra 550B icin konmustu ve
# tikanmis bir ucta kullaniciyi tam bir buçuk dakika bekletiyordu. Olculen
# gercek sure super-120b'de 1.9 saniye; 45 hala 20 katindan fazla pay birakir
# ve sentez coktugunde kullanici deterministik ozete cok daha hizli duser.
SYNTHESIZER_TIMEOUT_SECONDS=45
