# Uygulama
APP_ENV=development
LOG_LEVEL=INFO
# Frontend Vite kullaniyorsa 5173, CRA kullaniyorsa 3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Veritabani ---------------------------------------------------------
# BOS birakilirsa repository katmani bellek ici veriyi kullanir (test/demo).
# Doluysa db/v5_schema_and_data.sql semasi beklenir.
# DATABASE_URL=postgresql+psycopg://finans:finans@localhost:5432/finans
DB_ECHO=false

# --- Kimlik dogrulama ---------------------------------------------------
# Uretimde MUTLAKA degistirin.
JWT_SECRET=gelistirme-icin-gecici-anahtar-en-az-32-bayt
JWT_EXPIRE_MINUTES=720

# --- RAG / Vector DB ----------------------------------------------------
# EMBEDDING MODELI HENUZ SECILMEDI. Bos oldugu surece rag_search yalnizca
# BM25 ayagiyla calisir. Secildiginde db/v5_schema_and_data.sql icindeki
# vector(1024) boyutu IKI yerde birden guncellenmelidir.
EMBEDDING_MODEL=
EMBEDDING_DIM=1024

# --- LLM ----------------------------------------------------------------
# MODEL KARARI HENUZ VERILMEDI: bu alanlar bilincli olarak BOS. Anahtar veya
# model adi tanimli degilse ajanlar LLM'siz calisir (deterministik ozet).
# Karar verildiginde yalnizca burasi doldurulur, kod degismez.
LLM_API_KEY=
DEFAULT_MODEL=

# Ajan bazli model secimi (bos birakilirsa DEFAULT_MODEL kullanilir)
PORTFOLIO_MODEL=
MARKET_MODEL=
RISK_MODEL=
SYNTHESIZER_MODEL=
SECURITY_MODEL=

# --- Piyasa verisi katmani ----------------------------------------------
# simulated (varsayilan) | api | hybrid — api/hybrid PO onayi gerektirir
MARKET_DATA_PROVIDER=simulated
PRICE_TICK_SECONDS=60
MARKET_SIM_SEED=20260813

# --- Orkestrasyon timeout ayarlari (bir ajan asilirsa istek dusmesin) ----
AGENT_TIMEOUT_SECONDS=20
SYNTHESIZER_TIMEOUT_SECONDS=40
