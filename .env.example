# Uygulama
APP_ENV=development
LOG_LEVEL=INFO
# Frontend Vite kullaniyorsa 5173, CRA kullaniyorsa 3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Veritabani ---------------------------------------------------------
# BOS birakilirsa repository katmani bellek ici veriyi kullanir (test/demo).
# Doluysa db/v5_schema_and_data.sql semasi beklenir.
#
# BU DOSYA SABLONDUR VE GIT'E GIRER - buraya GERCEK sifre YAZMAYIN.
# Gercek deger `backend/.env` icine yazilir (.gitignore'da, git'e girmez).
# Surucu eki `+psycopg` ile yazilir; backend/README.md ve testler bu bicimi
# kullanir (db/session.py ikisini de kabul eder).
# DATABASE_URL=postgresql+psycopg://KULLANICI:SIFRE@HOST:5432/VERITABANI
DB_ECHO=false

# --- Kimlik dogrulama ---------------------------------------------------
# Uretimde MUTLAKA degistirin.
JWT_SECRET=gelistirme-icin-gecici-anahtar-en-az-32-bayt
JWT_EXPIRE_MINUTES=720

# --- RAG / Vector DB ----------------------------------------------------
# Model secildi: Cohere embed-v4 (output_dimension=1024, native destek -
# vector(1024) semasinda degisiklik gerekmez). EMBEDDING_API_KEY bos oldugu
# surece rag_search yalnizca BM25 ayagiyla calismaya devam eder.
EMBEDDING_MODEL=embed-v4.0
EMBEDDING_DIM=1024
EMBEDDING_API_KEY=

# --- Bulten gorselleri ----------------------------------------------------
# BOS birakilirsa haber gorseli eslestirme Pexels'e hic istek atmaz, dogrudan
# kategori bazli sabit gorsellere duser (bkz. app/services/news.py ->
# resolve_image). Ucretsiz Pexels hesabindan (pexels.com/api) alinir.
PEXELS_API_KEY=

# --- Google ile giris -----------------------------------------------------
# BOS birakilirsa POST /api/auth/google devre disidir, login sayfasindaki
# "Google ile devam et" butonu "henuz aktif degil" der (bkz. app/auth/google.py).
#
# ONEMLI: sadece CLIENT ID gerekir - client SECRET bu akista (erisim tokenini
# tokeninfo/userinfo uclariyla dogrulama) HIC KULLANILMAZ, hicbir yere
# yazmaniza gerek yok. Client ID zaten "public" kabul edilir (Google'in kendi
# dokumantasyonu client-side kodda gömülmesini bekler), yine de gercek deger
# backend/.env ve frontend/.env.local icine yazilir (ikisi de git'e girmez).
GOOGLE_CLIENT_ID=
# Frontend ayni degeri NEXT_PUBLIC_ onekiyle kendi .env.local dosyasinda tutar:
#   frontend/.env.local -> NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- LLM ----------------------------------------------------------------
# MODEL KARARI HENUZ VERILMEDI: bu alanlar bilincli olarak BOS. Anahtar veya
# model adi tanimli degilse ajanlar LLM'siz calisir (deterministik ozet).
# Karar verildiginde yalnizca burasi doldurulur, kod degismez.
LLM_API_KEY=
DEFAULT_MODEL=

# Ajan bazli model secimi (bos birakilirsa DEFAULT_MODEL kullanilir)
PORTFOLIO_MODEL=
MARKET_MODEL=
RISK_MODEL=
SYNTHESIZER_MODEL=
SECURITY_MODEL=

# --- Piyasa verisi katmani ----------------------------------------------
# Yahoo Finance'ten GERCEK fiyat kullanilir (app/market/yahoo.py).
# Yahoo'ya ulasilamazsa veya gunluk kota dolarsa yeni fiyat yazilmaz;
# son dogrulanmis fiyat korunur.
#
# PAYLASILAN VERITABANI UYARISI: DATABASE_URL ortak bir veritabanini (orn.
# ekibin Supabase'i) gosteriyorsa backend'i lokalde acan HER gelistirici o
# veritabanina fiyat yazar ve ayni Yahoo kotasini harcar. Yalnizca arayuzle
# ugrasiyorsaniz PRICE_TICK_SECONDS=0 ile fiyat gorevini tamamen kapatin.
MARKET_DATA_PROVIDER=api

# Fiyat gorevinin calisma araligi (saniye). 900 = 15 dakika -> gunde 96 tick.
# 0 = fiyat gorevi hic baslamaz.
#
# ⚠️ BU DEGERI KUCULTMEYIN. Bir tick TEK istek DEGILDIR: yfinance her ticker
# icin ayri HTTP istegi atar. 900'de gunde ~1.536 istek; 60'ta SAATTE 960
# istek eder ve 2.500'luk gunluk kota ~2,6 saatte biter. Kota bitince yeni
# fiyat hic yazilmaz, fiyatlar gunun geri kalaninda donar.
#
# 300 saniyenin altinda backend acilista uyari basar.
PRICE_TICK_SECONDS=900

# Her N tick'te bir live_prices'a satir yazilir. 1 = her tick.
# price_history'ye gun ici YAZILMAZ; oraya yalnizca gun bitiminde gunun
# kapanis fiyati tasinir (bkz. MARKET_DAY_TIMEZONE).
# Degisken adi eski .env dosyalari bozulmasin diye ayni birakildi.
PRICE_HISTORY_EVERY_N_TICKS=1

# Gun sinirinin belirlendigi saat dilimi. Bu saat diliminde gun degisince
# live_prices bosaltilir ve gunun son fiyati price_history'ye kapanis olarak
# yazilir. Sunucu UTC calissa bile gun Turkiye saatine gore biter.
MARKET_DAY_TIMEZONE=Europe/Istanbul

# Portfoy performans grafiginin guvenilir veri baslangici (ISO 8601).
# Bu tarihten onceki gelistirme/simulasyon kayitlari grafige alinmaz.
PORTFOLIO_PERFORMANCE_VALID_FROM=2026-08-21T10:41:00+03:00

# Gunluk dis API ISTEK tavani (market_api_usage tablosuyla takip edilir).
# Sayac ticker bazlidir: beklenen gunluk hacim ~1.536, tavan pay birakir.
MARKET_API_DAILY_QUOTA=2500

# --- Orkestrasyon timeout ayarlari (bir ajan asilirsa istek dusmesin) ----
AGENT_TIMEOUT_SECONDS=20
SYNTHESIZER_TIMEOUT_SECONDS=40

# --- Bildirim kanali (mail koprusu) --------------------------------------
# MAIL SU AN BAGLI DEGIL. Emir olaylari her durumda notification_outbox
# tablosuna yazilir; asagidakiler tanimlanana kadar gonderim yapilmaz ve
# satirlar SKIPPED olarak kapanir. Baglamak icin NOTIFICATIONS_ENABLED=true
# yapip SMTP_HOST'u doldurmak YETER - kodda degisiklik gerekmez.
NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Polifin <bildirim@polifin.local>
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10

# Bu yastan eski olaylar gonderilmez (SKIPPED). Kanal uzun sure kapali kalip
# sonra acilirsa birikmis gecmis bildirimlerin topluca gitmesini onler.
NOTIFICATION_MAX_AGE_MINUTES=60

# Tek turda islenecek azami outbox satiri.
NOTIFICATION_BATCH_SIZE=50

# --- Otonom oneri motoru (AUT / D-02) ------------------------------------
# Guven esiginin ALTINDA kalan sinyal kullaniciya hic ulasmaz (ic kayda alinir).
SIGNAL_CONFIDENCE_THRESHOLD=0.55

# BR-AUT-03: bir kullaniciya gunde en fazla kac oneri gonderilir.
MAX_DAILY_RECOMMENDATIONS=3

# BR-AUT-04: tarama bazli onerinin gecerlilik suresi (dakika).
RECOMMENDATION_TTL_MINUTES=240

# FR-AUT-010: bu saatler arasinda oneri URETILMEZ (market_day_timezone'a gore).
QUIET_HOURS_START=22
QUIET_HOURS_END=8

# Onerilen tutarin portfoy buyuklugune orani.
RECOMMENDATION_POSITION_PCT=0.05

# Tek tick'te taranacak azami kullanici; kalanlar sonraki tick'te islenir.
RECOMMENDATION_USERS_PER_TICK=5

# --- Veritabani baglanti havuzu -----------------------------------------
# Supabase session pooler'inda TOPLAM 25 slot var ve ekip bunu paylasiyor.
# SQLAlchemy varsayilani surec basina 15 baglanti acar; iki gelistirici
# backend acinca havuz patlar ve backend sessizce bellek ici veriye duser
# (sayfalar acilir ama portfoy/risk/likit para BOS gorunur).
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE_SECONDS=900
